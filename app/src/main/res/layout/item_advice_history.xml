<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tvDescriptionAdvice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/nobile_bold"
        android:text="Take a rest for a minute"
        android:textColor="@color/text"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/tvTimeAdvice"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/imageViewAdvice"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleAdvice" />

    <ImageView
        android:id="@+id/imageViewAdvice"
        android:layout_width="77dp"
        android:layout_height="77dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/circle_advice"
        android:padding="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_advice_bottle" />

    <TextView
        android:id="@+id/tvTitleAdvice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/nobile_bold"
        android:text="Take a rest for a minute"
        android:textColor="@color/text"
        android:textSize="20dp"
        app:layout_constraintEnd_toStartOf="@+id/tvTimeAdvice"
        app:layout_constraintStart_toEndOf="@+id/imageViewAdvice"
        app:layout_constraintTop_toTopOf="@+id/imageViewAdvice" />

    <TextView
        android:id="@+id/tvTimeAdvice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7:24"
        android:textColor="@color/text"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitleAdvice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitleAdvice" />
</androidx.constraintlayout.widget.ConstraintLayout>